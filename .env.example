# Lovable Cloud auto-populates these. Placeholders shown for reference only.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Server-side (available in server functions)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
SUPABASE_PROJECT_ID="your-project-id"

# Market data providers (charts fall back to simulated data if unset)
# Finnhub free key from https://finnhub.io — enables live US stock price stream
VITE_FINNHUB_API_KEY=your_finnhub_api_key_here
VITE_ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
